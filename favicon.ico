<svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFD700;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FF8C00;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="32" height="32" rx="4" fill="url(#goldGradient)"/>
  
  <!-- Hotel Building -->
  <rect x="8" y="12" width="16" height="16" fill="#2C3E50" rx="1"/>
  
  <!-- Windows -->
  <rect x="10" y="14" width="2" height="2" fill="#FFD700"/>
  <rect x="14" y="14" width="2" height="2" fill="#FFD700"/>
  <rect x="18" y="14" width="2" height="2" fill="#FFD700"/>
  <rect x="22" y="14" width="2" height="2" fill="#FFD700"/>
  
  <rect x="10" y="18" width="2" height="2" fill="#FFD700"/>
  <rect x="14" y="18" width="2" height="2" fill="#FFD700"/>
  <rect x="18" y="18" width="2" height="2" fill="#FFD700"/>
  <rect x="22" y="18" width="2" height="2" fill="#FFD700"/>
  
  <!-- Door -->
  <rect x="14" y="24" width="4" height="4" fill="#8B4513"/>
  
  <!-- Crown -->
  <polygon points="16,4 18,6 20,6 19,8 20,10 16,9 12,10 13,8 12,6 14,6" fill="#FFD700"/>
</svg>