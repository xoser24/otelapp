<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFD700;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#FFA500;stop-opacity:1" />
      <stop offset="70%" style="stop-color:#FF8C00;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#DAA520;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="buildingGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#34495E;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2C3E50;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="512" height="512" rx="64" fill="url(#goldGradient)"/>
  
  <!-- Hotel Building -->
  <rect x="128" y="192" width="256" height="256" fill="url(#buildingGradient)" rx="8"/>
  
  <!-- Building Shadow -->
  <rect x="136" y="200" width="248" height="248" fill="rgba(0,0,0,0.1)" rx="8"/>
  
  <!-- Windows Row 1 -->
  <rect x="160" y="224" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="224" y="224" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="288" y="224" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="352" y="224" width="32" height="32" fill="#FFD700" rx="4"/>
  
  <!-- Windows Row 2 -->
  <rect x="160" y="288" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="224" y="288" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="288" y="288" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="352" y="288" width="32" height="32" fill="#FFD700" rx="4"/>
  
  <!-- Windows Row 3 -->
  <rect x="160" y="352" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="224" y="352" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="288" y="352" width="32" height="32" fill="#FFD700" rx="4"/>
  <rect x="352" y="352" width="32" height="32" fill="#FFD700" rx="4"/>
  
  <!-- Main Door -->
  <rect x="224" y="384" width="64" height="64" fill="#8B4513" rx="4"/>
  <circle cx="272" cy="416" r="4" fill="#FFD700"/>
  
  <!-- Hotel Sign -->
  <rect x="192" y="144" width="128" height="32" fill="#2C3E50" rx="4"/>
  <text x="256" y="164" text-anchor="middle" fill="#FFD700" font-family="Arial, sans-serif" font-size="18" font-weight="bold">HOTEL</text>
  
  <!-- Crown/Star -->
  <polygon points="256,64 272,96 304,96 280,120 288,152 256,136 224,152 232,120 208,96 240,96" fill="#FFD700" stroke="#FF8C00" stroke-width="4"/>
  
  <!-- Decorative Elements -->
  <circle cx="96" cy="128" r="8" fill="#FFD700" opacity="0.7"/>
  <circle cx="416" cy="128" r="8" fill="#FFD700" opacity="0.7"/>
  <circle cx="96" cy="384" r="8" fill="#FFD700" opacity="0.7"/>
  <circle cx="416" cy="384" r="8" fill="#FFD700" opacity="0.7"/>
</svg>