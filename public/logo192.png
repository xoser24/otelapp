<svg width="192" height="192" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFD700;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#FFA500;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FF8C00;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="192" height="192" rx="24" fill="url(#goldGradient)"/>
  
  <!-- Hotel Building -->
  <rect x="48" y="72" width="96" height="96" fill="#2C3E50" rx="4"/>
  
  <!-- Windows -->
  <rect x="60" y="84" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="84" y="84" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="108" y="84" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="132" y="84" width="12" height="12" fill="#FFD700" rx="2"/>
  
  <rect x="60" y="108" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="84" y="108" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="108" y="108" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="132" y="108" width="12" height="12" fill="#FFD700" rx="2"/>
  
  <rect x="60" y="132" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="84" y="132" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="108" y="132" width="12" height="12" fill="#FFD700" rx="2"/>
  <rect x="132" y="132" width="12" height="12" fill="#FFD700" rx="2"/>
  
  <!-- Door -->
  <rect x="84" y="144" width="24" height="24" fill="#8B4513" rx="2"/>
  <circle cx="102" cy="156" r="2" fill="#FFD700"/>
  
  <!-- Crown/Star -->
  <polygon points="96,24 102,36 114,36 105,45 108,57 96,51 84,57 87,45 78,36 90,36" fill="#FFD700" stroke="#FF8C00" stroke-width="2"/>
</svg>