// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kullanıcı modeli (personel, yönetici)
model User {
  id            String             @id @default(uuid())
  email         String             @unique
  password      String
  name          String
  role          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  notifications Notification[]
  tasks         HousekeepingTask[]
}

// Oda modeli
model Room {
  id               String              @id @default(uuid())
  number           String              @unique
  type             String
  status           String              @default("AVAILABLE")
  floor            Int
  cleaningStatus   String              @default("CLEAN")
  lastCleaned      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  bookings         Booking[]
  cleaningTasks    HousekeepingTask[]
  maintenanceTasks MaintenanceTask[]
  statusEvents     RoomStatusHistory[]
}

// Merkezi oda durum geçmişi (occupied, dirty, cleaning, clean, empty)
model RoomStatusHistory {
  id         String      @id @default(uuid())
  roomNumber String
  status     String
  meta       String?
  changedAt  DateTime    @default(now())
  room       Room?       @relation(fields: [roomNumber], references: [number])
}

// Misafir modeli
model Guest {
  id           String        @id @default(uuid())
  name         String
  email        String?
  phone        String?
  nationality  String?
  language     String?       @default("tr")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     Booking[]
  feedbacks    Feedback[]
  chatMessages ChatMessage[]
}

// Rezervasyon modeli
model Booking {
  id             String        @id @default(uuid())
  roomId         String
  guestId        String
  checkIn        DateTime
  checkOut       DateTime
  status         String        @default("CONFIRMED")
  cleaningOptOut Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  room           Room          @relation(fields: [roomId], references: [id])
  guest          Guest         @relation(fields: [guestId], references: [id])
}

// Housekeeping görev modeli
model HousekeepingTask {
  id           String       @id @default(uuid())
  roomId       String
  assignedToId String?
  status       String       @default("PENDING")
  priority     String       @default("MEDIUM")
  description  String?
  startTime    DateTime?
  endTime      DateTime?
  duration     Int? // Dakika cinsinden süre
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  room         Room         @relation(fields: [roomId], references: [id])
  assignedTo   User?        @relation(fields: [assignedToId], references: [id])
}

// Bakım görev modeli
model MaintenanceTask {
  id          String       @id @default(uuid())
  roomId      String
  status      String       @default("PENDING")
  priority    String       @default("MEDIUM")
  description String
  reportedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  room        Room         @relation(fields: [roomId], references: [id])
}

// Misafir geri bildirimi modeli
model Feedback {
  id        String           @id @default(uuid())
  guestId   String
  category  String
  rating    Int? // 1-5 arası puanlama
  comment   String?
  sentiment String?
  createdAt DateTime         @default(now())
  guest     Guest            @relation(fields: [guestId], references: [id])
}

// Sohbet mesajı modeli
model ChatMessage {
  id                 String   @id @default(uuid())
  guestId            String?
  userId             String?
  content            String
  isFromGuest        Boolean
  isTranslated       Boolean  @default(false)
  originalContent    String?
  originalLanguage   String?
  translatedLanguage String?
  isRead             Boolean  @default(false)
  createdAt          DateTime @default(now())
  guest              Guest?   @relation(fields: [guestId], references: [id])
}

// Bildirim modeli
model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

// Sürdürülebilirlik metrikleri modeli
model SustainabilityMetric {
  id          String     @id @default(uuid())
  metricType  String
  value       Float
  unit        String
  date        DateTime
  description String?
  createdAt   DateTime   @default(now())
}
